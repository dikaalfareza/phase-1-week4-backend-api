generator client {
  provider = "prisma-client-js"
  output   = "./generated/client"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id    Int      @id @default(autoincrement())
  name  String
  email String   @unique
  phone String   @unique
  todos Todo[]
}

model Todo {
  id          Int     @id @default(autoincrement())
  title       String
  description String?
  status      Status  @default(toDo)
  userId      Int
  user        User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum Status {
  toDo
  inProgress
  Done
}
